{
  "name": "hongseungah-tech-blog",
  "private": true,
  "description": "홍승아 기술 블로그 — Next.js 16 · Tailwind · i18n",
  "version": "1.0.0",
  "author": "홍승아 <gmm117@naver.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-content-assets.mjs",
    "fetch:popular": "node scripts/fetch-popular-posts.mjs",
    "predev": "pnpm sync:assets",
    "dev": "next dev",
    "prebuild": "pnpm sync:assets",
    "build": "next build",
    "serve": "serve out",
    "clean": "rm -rf .next out test-results .vitest public/blog-assets *.tsbuildinfo",
    "lint": "node --import ./scripts/eslint-ts5-shim.mjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --import ./scripts/eslint-ts5-shim.mjs ./node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:ts5": "node node_modules/typescript-5/bin/tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "test:smoke": "vitest run -t '@smoke' && playwright test --grep @smoke",
    "test:regression": "vitest run && playwright test --grep @regression",
    "test:nightly": "vitest run && playwright test --grep '@regression|@nightly'",
    "test:e2e:mock": "playwright test --grep @e2e-mock",
    "test:e2e:live": "E2E_MODE=live playwright test --grep @e2e-live",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d out -t true -b gh-pages",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^1.46.0",
    "next": "^16.3.5",
    "next-themes": "^0.4.6",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.5",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "shiki": "^4.4.3",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/eslintrc": "^3.3.7",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/typography": "^0.5.20",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.20.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.5",
    "eslint-config-prettier": "^10.1.8",
    "gh-pages": "^6.3.0",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "postcss": "^8.5.28",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "serve": "^14.2.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seungahhong/seungahhong.github.io"
  }
}
