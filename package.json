{
  "name": "hongseungah-tech-blog",
  "private": true,
  "description": "홍승아 기술 블로그 — Next.js 16 · Tailwind · i18n",
  "version": "1.0.0",
  "author": "홍승아 <gmm117@naver.com>",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20.9.0"
  },
  "scripts": {
    "sync:assets": "node scripts/sync-content-assets.mjs",
    "fetch:popular": "node scripts/fetch-popular-posts.mjs",
    "predev": "pnpm sync:assets",
    "dev": "next dev",
    "prebuild": "pnpm sync:assets",
    "build": "next build",
    "serve": "serve out",
    "clean": "rm -rf .next out test-results public/blog-assets *.tsbuildinfo",
    "lint": "node --import ./scripts/eslint-ts5-shim.mjs ./node_modules/eslint/bin/eslint.js .",
    "lint:fix": "node --import ./scripts/eslint-ts5-shim.mjs ./node_modules/eslint/bin/eslint.js . --fix",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "typecheck:ts5": "node node_modules/typescript-5/bin/tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,md,json,css}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:debug": "playwright test --debug",
    "predeploy": "pnpm build",
    "deploy": "gh-pages -d out -t true -b main",
    "prepare": "husky"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "github-slugger": "^2.0.0",
    "gray-matter": "^4.0.3",
    "lucide-react": "^0.469.0",
    "next": "^16.2.12",
    "next-themes": "^0.4.6",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.14.0",
    "rehype-raw": "^7.0.0",
    "rehype-slug": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.0",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.1",
    "shiki": "^1.24.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/eslintrc": "^3.2.0",
    "@playwright/test": "^1.49.1",
    "@tailwindcss/typography": "^0.5.15",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/hast": "^3.0.5",
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "@types/unist": "^3.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "eslint": "^9.17.0",
    "eslint-config-next": "^16.2.12",
    "eslint-config-prettier": "^9.1.0",
    "gh-pages": "^6.2.0",
    "husky": "^9.1.7",
    "jsdom": "^25.0.1",
    "postcss": "^8.4.49",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "serve": "^14.2.4",
    "tailwindcss": "^3.4.17",
    "typescript": "^7.0.2",
    "typescript-5": "npm:typescript@5.9.3",
    "vitest": "^2.1.8"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/seungahhong/seungahhong.github.io"
  }
}
